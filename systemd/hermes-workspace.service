[Unit]
Description=Hermes
After=network.target

[Service]
Type=simple
User=ntsd
Group=ntsd
WorkingDirectory=/home/ntsd/hermes-workspace

Environment="PATH=/home/ntsd/.nvm/versions/node/v26.1.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/home/ntsd/hermes-workspace.env

# use dev instead of start for the webui update
ExecStart=/home/ntsd/.nvm/versions/node/v26.1.0/bin/npm dev
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal


[Install]
WantedBy=multi-user.target
