[Unit]
Description=Zero Factory Astro Dashboard
After=network.target zerofactory-api.service

[Service]
Type=simple
User=ntsd
WorkingDirectory=/home/ntsd/git/hotcode-dev/zerofactory/dashboard
# Use the full path to bun executable
ExecStart=/home/ntsd/.bun/bin/bun run dev --host --port 18789
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
