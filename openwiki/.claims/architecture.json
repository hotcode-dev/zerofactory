  "claims": [
    {
      "id": "claim_80cf282ecc34488f9bf7da2c69151cc1",
      "statement": "Zero Factory is a self-contained Hermes Agent plugin (zerofactory) that runs a 24/7 multi-agent software factory of four specialist profiles - zf-orchestrator, zf-goldfish, zf-builder, zf-reviewer - on a durable Kanban board.",
      "evidence": [
        {
          "resource": "repo://plugin.yaml#L1-L8",
          "version": "repo-lines-v1:sha256:0d966819839fa0d3b24a42e9375fa536d73eb785918893f0972cd29d6f737aeb:"
        }
      ]
    },
    {
      "id": "claim_e88291ffc8a845e3b33658fed8c5a034",
      "statement": "The core loop, run_dispatch_cycle, acquires a process-level exclusive file lock (fcntl.flock LOCK_EX | LOCK_NB) before mutating board state, serializing concurrent dispatch cycles.",
      "evidence": [
        {
          "resource": "repo://dispatcher/scheduler.py#L40-L80",
          "version": "repo-lines-v1:sha256:5b6b546ed629c752e7333992ee09335932c1002eec45e83ad52102f21e1ce7be:"
        }
      ]
    },
    {
      "id": "claim_aeb90b89f2914bc6ae14fd74eaf4b099",
      "statement": "Worker spawning is isolated: spawn_agent_worker launches `hermes -p <assignee> ... --cli chat -q <prompt>` as a detached subprocess (stdin=DEVNULL, start_new_session=True, stderr merged into the worker log) with the worker's HERMES_HOME pinned to the profile's home — `--yolo --accept-hooks` are appended only when the allow_unattended_approvals setting is enabled — then correlates the new session_id against the profile's state.db.",
      "evidence": [
        {
          "resource": "repo://dispatcher/worker_spawner.py#L751-L790",
          "version": "repo-lines-v1:sha256:fe62c7937975addc66b37b9b62e5270f0b1f1e70884056f693e51e4513497fbd:"
        }
      ]
    },
    {
      "id": "claim_977216a210934faa92eaa6897f799d6e",
      "statement": "Agent prompts are pre-digested in Python before the agent wakes: digest_reviewer_git_context pre-computes the git log, diffstat, and a bounded diff (max 100 lines / 4000 chars) so the reviewer avoids exploratory git tool calls.",
      "evidence": [
        {
          "resource": "repo://dispatcher/context_builder.py#L15-L88",
          "version": "repo-lines-v1:sha256:9ad410f118872d399ae9ee11510c1d1d9dd64869b74ecd7647ab979253d77b56:"
        }
