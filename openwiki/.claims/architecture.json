    },
    {
      "id": "claim_aeb90b89f2914bc6ae14fd74eaf4b099",
      "statement": "Worker spawning is isolated: spawn_agent_worker launches `hermes -p <assignee> ... --yolo --accept-hooks chat -q <prompt>` as a detached subprocess with the worker's HERMES_HOME pinned to the profile's home, then correlates the new session_id against the profile's state.db.",
      "evidence": [
