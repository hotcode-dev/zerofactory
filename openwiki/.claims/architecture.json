  "claims": [
    {
      "id": "claim_80cf282ecc34488f9bf7da2c69151cc1",
      "statement": "Zero Factory is a self-contained Hermes Agent plugin (zerofactory, v1.1.0) that runs a 24/7 multi-agent software factory of three specialist profiles — zf-orchestrator, zf-builder, zf-reviewer — on a durable Kanban board.",
      "evidence": [
        {
          "resource": "repo://plugin.yaml#L1-L8",
          "version": "repo-lines-v1:sha256:1524812f41a07e883d94c88f5a00af042a1e39a6edad5c03d3fcc3682fefbd82:"
        }
      ]
    },
    {
      "id": "claim_e88291ffc8a845e3b33658fed8c5a034",
      "statement": "The core loop, run_dispatch_cycle, acquires a process-level exclusive file lock (fcntl.flock LOCK_EX | LOCK_NB) before mutating board state, serializing concurrent dispatch cycles.",
      "evidence": [
        {
          "resource": "repo://dispatcher/scheduler.py#L36-L70",
          "version": "repo-lines-v1:sha256:b4fd3be1aa917f89135128534a6c882ac9a14c6a98183626ca7f939c3736eb71:"
        }
      ]
    },
    {
      "id": "claim_aeb90b89f2914bc6ae14fd74eaf4b099",
      "statement": "Worker spawning is isolated: spawn_agent_worker launches `hermes -p <assignee> ... --yolo --accept-hooks chat -q <prompt>` as a detached subprocess (stdin=DEVNULL, start_new_session=True, stderr merged into the worker log) with the worker's HERMES_HOME pinned to the profile's home, then correlates the new session_id against the profile's state.db.",
      "evidence": [
        {
          "resource": "repo://dispatcher/worker_spawner.py#L550-L618",
          "version": "repo-lines-v1:sha256:4941508f5197e75dc3c2564b0320f577fdc8d085c9625629363a80ce872ffecb:"
