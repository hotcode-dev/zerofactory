    {
      "id": "claim_e244654233ea4553a219a0f9a7e4a1a0",
      "statement": "The deterministic precommit gate runs `ruff check --fix .` then `ruff format .` (format phase, auto-installing pinned ruff==0.16.9 when missing), `python3 -m compileall -q .` (build phase), and `python3 -m pytest tests/ -q` (test phase, auto-installing a pinned pytest + plugin-runtime-deps stack and never falling back to unittest discovery), and the dispatcher re-runs the gate and re-spawns the builder on any failure.",
      "evidence": [
        {
          "resource": "repo://.zerofactory/precommit.sh",
          "version": "repo-file-v1:sha256:8d9eab249bc1a6ac3c0c3e9a41fd8a65282bc1c0f33fb1a847c796658a27c646"
