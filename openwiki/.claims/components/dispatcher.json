        }
      ]
    },
    {
      "id": "claim_9679acaedd20479ebea365651adfda16",
      "statement": "The dispatcher claims ready tasks under per-board max_concurrent_running plus global DEFAULT_MAX_CONCURRENT_WORKERS and DEFAULT_MAX_CONCURRENT_LLM_WORKERS caps, and enforces a 1-hour per-task max running time and a 15-minute inactivity timeout.",
