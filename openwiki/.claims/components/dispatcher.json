    {
      "id": "claim_3df9c00b1980410b912370115c7db67e",
      "statement": "Every task executes in its own isolated Git worktree on a task/<task_id> branch (setup_worktree resolves the repository and creates ~/.zerofactory/workspaces/<board>/worktrees/<task_id>/<repo_alias> on a task/<task_id> branch; every `git worktree add` runs under _WORKTREE_ADD_TIMEOUT with prune+retry on failure), so a worker never touches main directly — the worktree + branch are the durable substrate that survives a worker crash.",
      "evidence": [
        {
          "resource": "repo://dispatcher/worktree.py#L174-L588",
          "version": "repo-lines-v1:sha256:2b80fe212b2ac0a02cf25c3176f1bad38816db800d41a6363f7a2bb53ea420ed:"
        }
