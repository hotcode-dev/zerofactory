    {
      "id": "claim_c2147ad6765547fc8b36019ed25959a4",
      "statement": "run_dispatch_cycle is the single unit of work the dispatcher, queue watchdog, and CLI `dispatch` command all trigger; it runs behind a process-level exclusive file lock so concurrent cycles never corrupt board state, and a background thread (_dispatcher_loop via start_background_dispatcher) drives it every DISPATCH_INTERVAL_SECONDS (30s).",
      "evidence": [
        {
          "resource": "repo://dispatcher/scheduler.py#L2394-L2431",
          "version": "repo-lines-v1:sha256:9e6195e623077efca31d14b59abe5cda578a7fe4e505e97806e283ea6a569125:"
        },
        {
