    {
      "id": "claim_c2147ad6765547fc8b36019ed25959a4",
      "statement": "run_dispatch_cycle is the single unit of work the dispatcher, queue watchdog, and CLI `dispatch` command all trigger; it runs behind a process-level exclusive file lock so concurrent cycles never corrupt board state, and a background thread drives it every DISPATCH_INTERVAL_SECONDS (30s).",
      "evidence": [
        {
          "resource": "repo://dispatcher/scheduler.py#L1412-L1444",
          "version": "repo-lines-v1:sha256:7c3c22fe0a38eac8757441c414d7a6b747bff1c6ba465e8bdee5ab7d0011fa9d:"
