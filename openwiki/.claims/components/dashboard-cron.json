          "resource": "repo://dashboard/gh_issues_service.py#L100-L118",
          "version": "repo-lines-v1:sha256:4b404be5b8fd3b373db5fdb1c1ec0747f0b3a24b4c1097bf121a5733a0eda8fa:"
