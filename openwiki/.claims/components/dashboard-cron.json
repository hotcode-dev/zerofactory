    {
      "id": "claim_5e35f159a4d34e98b26fc9fef4faaf63",
      "statement": "dashboard/routes/dispatch.py exposes operator control over the background loop: POST /dispatch/run triggers one run_dispatch_cycle; POST /dispatch/start verifies profile readiness then starts the in-process loop; POST /dispatch/stop stops it; GET /dispatch/status lists in-flight running/blocked tasks; GET /health/stuck-tasks, POST /health/reap-stuck, and POST /tasks/{task_id}/reap expose the reaper's inspection and single-task reap.",
