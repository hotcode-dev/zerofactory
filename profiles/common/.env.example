# Runtime model/provider overrides (optional)
HERMES_MODEL=qwen36-fast
HERMES_INFERENCE_PROVIDER=custom
CUSTOM_BASE_URL=http://spark.ntsd.dev:8000/v1

# Hermes Agent browser tools — use the system Chrome/Chromium binary.
AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Hermes gateway config
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0

# API_SERVER_KEY is required for 0.0.0.0.
# SECURITY (zf-21718ce2): keep the placeholder EMPTY. Supply the real key out-of-band
# (e.g. an untracked per-machine secrets file — cp .env.example .env and fill the key,
# chmod 600 .env). .env is gitignored; only .env.example is tracked.
API_SERVER_KEY=

# SECURITY (zf-21718ce2): default to deny — the gateway authenticates callers via
# API_SERVER_KEY. Set to true only if anonymous callers are genuinely required.
GATEWAY_ALLOW_ALL_USERS=false

# Discord configuration (for Discord skill and gateway integration)
DISCORD_HOME_CHANNEL=
DISCORD_HOME_CHANNEL_THREAD_ID=
