# Runtime model/provider overrides (optional)
HERMES_MODEL=qwen36-fast
HERMES_INFERENCE_PROVIDER=custom
CUSTOM_BASE_URL=http://spark.ntsd.dev:8000/v1

# Hermes Agent browser tools — use the system Chrome/Chromium binary.
AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Hermes gateway config
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0

# API_SERVER_KEY is required for 0.0.0.0.
API_SERVER_KEY=
GATEWAY_ALLOW_ALL_USERS=true

# Discord configuration (for Discord skill and gateway integration)
DISCORD_HOME_CHANNEL=
DISCORD_HOME_CHANNEL_THREAD_ID=
