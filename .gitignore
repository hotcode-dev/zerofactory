/hermes/*
!/hermes/profiles/
!/hermes/bin/
!/hermes/README.md

# Profiles rules (merged from profiles/.gitignore)
profiles/*
!profiles/*/

# ignore all files inside profile subdirectories
profiles/*/**

# unignore all files in common
!profiles/common/.env
!profiles/common/.env.example
!profiles/common/config.yaml
!profiles/common/SOUL.md
!profiles/common/skills/zerofactory-orchestration/**

# unignore .env
!profiles/*/.env
!profiles/*/.env.example

# unignore custom SOUL.md
!profiles/*/SOUL.custom.md

# unignore custom config
!profiles/*/config.custom.yaml

# unignore cron
!profiles/*/cron/
!profiles/*/cron/jobs.custom.json

# unignore skills
!profiles/*/skills/
!profiles/*/skills/zerofactory-orchestration

# IMPORTANT: If you create a new custom skill or add anything not built-in to Hermes,
# you must explicitly unignore it here before you can commit and push it to GitHub!
# Example: !profiles/*/skills/my-new-skill

# unignore plugins
!plugins/
!plugins/**
