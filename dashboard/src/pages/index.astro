---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Zero Factory - Dashboard">
	<main class="container">
		<header class="hero">
			<h1>Zero Factory <span class="highlight">LangGraph</span></h1>
			<p>Next-gen multi-agent orchestration.</p>
		</header>

		<section class="glass-panel orchestrator-panel">
			<h2>Launch Goal</h2>
			<div class="input-group">
				<input type="text" id="goal-input" placeholder="e.g. Build a new feature for user authentication..." />
				<button id="start-btn" class="glow-btn">Start Execution</button>
			</div>
			
			<div id="status-display" class="status-box hidden">
				<div class="pipeline">
					<div class="stage" id="stage-Triage">Triage</div>
					<div class="stage-connector"></div>
					<div class="stage" id="stage-Todo">Todo</div>
					<div class="stage-connector"></div>
					<div class="stage" id="stage-Ready">Ready (Builder)</div>
					<div class="stage-connector"></div>
					<div class="stage" id="stage-Testing">Testing</div>
					<div class="stage-connector"></div>
					<div class="stage" id="stage-Blocked">Blocked (Reviewer)</div>
					<div class="stage-connector"></div>
					<div class="stage" id="stage-Done">Done</div>
				</div>
				
				<div class="log-container" id="log-container">
					<!-- Logs will appear here -->
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	:root {
		--bg-color: #0d0f14;
		--text-main: #e2e8f0;
		--text-muted: #94a3b8;
		--accent: #6366f1;
		--accent-glow: rgba(99, 102, 241, 0.4);
		--success: #10b981;
		--glass-bg: rgba(255, 255, 255, 0.03);
		--glass-border: rgba(255, 255, 255, 0.08);
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-main);
		font-family: 'Inter', system-ui, sans-serif;
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background-image: radial-gradient(circle at 50% 0%, #1e1b4b 0%, var(--bg-color) 60%);
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.hero {
		text-align: center;
		margin-bottom: 4rem;
		animation: fade-in 1s ease-out;
	}

	h1 {
		font-size: 3.5rem;
		font-weight: 800;
		margin: 0 0 1rem 0;
		letter-spacing: -1px;
	}

	.highlight {
		background: linear-gradient(135deg, #a855f7, #6366f1);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero p {
		font-size: 1.2rem;
		color: var(--text-muted);
	}

	.glass-panel {
		background: var(--glass-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--glass-border);
		border-radius: 16px;
		padding: 2.5rem;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		transition: transform 0.3s ease;
	}

	h2 {
		margin-top: 0;
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.input-group {
		display: flex;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	input {
		flex: 1;
		background: rgba(0, 0, 0, 0.2);
		border: 1px solid var(--glass-border);
		border-radius: 8px;
		padding: 1rem 1.2rem;
		color: white;
		font-size: 1rem;
		transition: all 0.2s;
	}

	input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent-glow);
	}

	.glow-btn {
		background: var(--accent);
		color: white;
		border: none;
		border-radius: 8px;
		padding: 1rem 2rem;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
		box-shadow: 0 4px 14px 0 var(--accent-glow);
	}

	.glow-btn:hover:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: 0 6px 20px rgba(99, 102, 241, 0.6);
		background: #7174ff;
	}

	.glow-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.status-box {
		border-top: 1px solid var(--glass-border);
		padding-top: 2rem;
		animation: fade-in 0.5s ease-out;
	}

	.hidden {
		display: none;
	}
	
	.pipeline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
		padding: 1rem;
		background: rgba(0, 0, 0, 0.2);
		border-radius: 12px;
	}
	
	.stage {
		padding: 0.5rem 1rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-muted);
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		transition: all 0.4s ease;
		border: 1px solid transparent;
	}
	
	.stage.active {
		background: rgba(99, 102, 241, 0.15);
		color: #a5b4fc;
		border-color: var(--accent);
		box-shadow: 0 0 15px var(--accent-glow);
		transform: scale(1.05);
	}
	
	.stage.completed {
		background: rgba(16, 185, 129, 0.15);
		color: var(--success);
		border-color: rgba(16, 185, 129, 0.3);
	}

	.stage-connector {
		flex: 1;
		height: 2px;
		background: rgba(255, 255, 255, 0.1);
		margin: 0 10px;
		position: relative;
	}

	.log-container {
		background: rgba(0, 0, 0, 0.4);
		border-radius: 8px;
		padding: 1rem;
		font-family: 'Fira Code', monospace;
		font-size: 0.875rem;
		color: #94a3b8;
		min-height: 200px;
		max-height: 400px;
		overflow-y: auto;
		border: 1px solid var(--glass-border);
	}
	
	.log-entry {
		margin-bottom: 0.5rem;
		line-height: 1.4;
		animation: slide-in 0.3s ease-out;
	}
	
	.log-entry.system { color: #a5b4fc; }
	.log-entry.error { color: #ef4444; }
	.log-entry.success { color: #10b981; }

	@keyframes fade-in {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
	
	@keyframes slide-in {
		from { opacity: 0; transform: translateX(-10px); }
		to { opacity: 1; transform: translateX(0); }
	}
</style>

<script>
	const startBtn = document.getElementById('start-btn') as HTMLButtonElement;
	const goalInput = document.getElementById('goal-input') as HTMLInputElement;
	const statusDisplay = document.getElementById('status-display');
	const logContainer = document.getElementById('log-container');
	
	const stages = ['Triage', 'Todo', 'Ready', 'Testing', 'Blocked', 'Done'];

	let eventSource: EventSource | null = null;

	function appendLog(message: string, type = 'normal') {
		if (logContainer) {
			const logEntry = document.createElement('div');
			logEntry.className = `log-entry ${type}`;
			
			// Simple syntax highlighting for brackets and JSON-like strings
			let formattedMsg = message
				.replace(/\[([^\]]+)\]/g, '<span style="color: #6366f1; font-weight: 600;">[$1]</span>')
				.replace(/\{([^}]+)\}/g, '<span style="color: #10b981;">{$1}</span>');
				
			logEntry.innerHTML = formattedMsg;
			logContainer.appendChild(logEntry);
			logContainer.scrollTop = logContainer.scrollHeight;
		}
	}
	
	function updatePipeline(currentStage: string) {
		let foundCurrent = false;
		for (const stage of stages) {
			const el = document.getElementById(`stage-${stage}`);
			if (!el) continue;
			
			el.classList.remove('active', 'completed');
			
			if (stage === currentStage) {
				el.classList.add('active');
				foundCurrent = true;
			} else if (!foundCurrent) {
				el.classList.add('completed');
			}
		}
	}

	startBtn?.addEventListener('click', async () => {
		const goal = goalInput?.value;
		if (!goal) return;

		statusDisplay?.classList.remove('hidden');
		if (startBtn) startBtn.disabled = true;
		
		if (logContainer) logContainer.innerHTML = '';
		updatePipeline('Triage');
		
		if (eventSource) {
			eventSource.close();
		}

		try {
			const res = await fetch('/api/start', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ goal })
			});
			
			const data = await res.json();
			const threadId = data.threadId;
			appendLog(`[SYSTEM] Goal initialized. Thread ID: ${threadId}`, 'system');
			
			eventSource = new EventSource(`/api/stream?threadId=${threadId}`);
			
			eventSource.onmessage = (event) => {
				const streamData = JSON.parse(event.data);
				
				if (streamData.type === 'connected') {
					appendLog(`[SYSTEM] Connected to live event stream.`, 'system');
				} else if (streamData.type === 'state') {
					const state = streamData.values;
					
					if (state.status) {
						updatePipeline(state.status);
					}
					
					const lastMsg = state.messages && state.messages.length > 0 
						? state.messages[state.messages.length - 1].kwargs?.content
						: 'State transition...';
					
					const logType = state.status === 'Done' ? 'success' : 'normal';
					appendLog(`[${state.status}] ${lastMsg}`, logType);
					
					if (state.status === 'Done') {
						appendLog(`[SYSTEM] Workflow complete.`, 'success');
						eventSource?.close();
						if (startBtn) startBtn.disabled = false;
					}
				}
			};

			eventSource.onerror = () => {
				appendLog(`[ERROR] Lost connection to stream.`, 'error');
				eventSource?.close();
				if (startBtn) startBtn.disabled = false;
			};

		} catch (err: any) {
			appendLog(`[ERROR] connecting to backend: ${err.message}`, 'error');
			if (startBtn) startBtn.disabled = false;
		}
	});
</script>
